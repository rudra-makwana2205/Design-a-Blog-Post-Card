/* Base Reset */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* User Story 4 & Test 10: Non-white body background */
body {
  background-color: #e2e8f0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20px;
}

/* User Story 5 & Tests 8, 9, 11, 12: Main Card Styles */
.blog-post-card {
  background-color: #ffffff;
  border-radius: 12px;
  width: 350px;
  text-align: left;
  overflow: hidden; /* Keeps image corners aligned with card border-radius */
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

/* User Story 6 & Tests 21, 22: Full Width Image with Bottom Border */
.post-img {
  width: 100%;
  height: auto;
  display: block;
  border-bottom: 4px solid #0284c7;
}

/* User Story 7 & Test 13: Content Container Padding */
.post-content {
  padding: 24px;
}

/* User Story 8 & Test 23: Title & Excerpt Styling */
.post-title {
  color: #0f172a;
  margin: 12px 0;
  font-size: 1.35rem;
  line-height: 1.3;
}

.post-excerpt {
  color: #475569;
  margin: 12px 0 20px 0;
  font-size: 0.95rem;
  line-height: 1.5;
}

/* User Story 9 & Tests 14-20: Read More Button Link */
.read-more {
  display: inline-block;
  color: #ffffff;
  background-color: #0284c7;
  margin: 8px 0;
  padding: 10px 20px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
  transition: background-color 0.2s ease-in-out;
}

/* Hover Effect for Read More Button */
.read-more:hover {
  background-color: #0369a1;
}
